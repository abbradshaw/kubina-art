---
import Layout from "../layouts/Layout.astro";
import MasonryGallery from "../components/MasonryGallery.astro";
import { getAllWorks } from "../lib/works";

const allWorks = await getAllWorks();
const sortedWorks = allWorks.sort(
	(a, b) => parseInt(b.year) - parseInt(a.year),
);
---

<Layout
	title="Peter Kubina | Archive"
	description="The complete works of Peter Kubina"
>
	<header class="text-center py-20 px-6">
		<h1
			class="font-serif text-4xl md:text-6xl text-neutral-900 dark:text-gray-100 tracking-tight mb-4"
		>
			Peter Kubina
		</h1>
		<nav
			class="flex justify-center items-center gap-6 text-base font-sans uppercase tracking-widest text-neutral-500 dark:text-neutral-400"
		>
			<a
				href="/about"
				class="hover:text-black dark:hover:text-white transition-colors"
				>About the Artist</a
			>
			<span class="text-neutral-300 dark:text-neutral-600">•</span>
			<span class="text-black dark:text-gray-100 font-medium"
				>Collection</span
			>
		</nav>
	</header>

	<main class="mb-12">
		<MasonryGallery works={sortedWorks} />
	</main>
</Layout>

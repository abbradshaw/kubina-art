---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

// 1. Fetch the biography content (Assuming a singleton pattern or specific ID)
// You might need to adjust 'pages' to match your actual collection name for static pages
const bioEntry = await getEntry("pages", "about");
if (!bioEntry) {
    throw new Error("About page entry not found");
}
const { Content } = await bioEntry.render();

// Placeholder for signature if you have one scanned (adds a nice personal touch)
// const signatureImg = "...";
---

<Layout title="About the Artist | Peter Kubina Archive">
    <header class="text-center py-20 px-6">
        <h1
            class="font-serif text-4xl md:text-6xl text-neutral-900 dark:text-gray-100 tracking-tight mb-4"
        >
            <a href="/" class="hover:text-neutral-600 transition-colors"
                >Peter Kubina</a
            >
        </h1>
        <nav
            class="flex justify-center items-center gap-6 text-base font-sans uppercase tracking-widest text-neutral-500 dark:text-neutral-400"
        >
            <span class="text-black dark:text-gray-100 font-medium"
                >About the Artist</span
            >
            <span class="text-neutral-300 dark:text-neutral-600">•</span>
            <a
                href="/"
                class="hover:text-black dark:hover:text-white transition-colors"
                >Collection</a
            >
            <span class="text-neutral-300 dark:text-neutral-600">•</span>
            <ThemeToggle />
        </nav>
    </header>

    <main class="max-w-4xl mx-auto px-6 pb-24 pt-24">
        <header class="flex flex-col items-center mb-16 text-center">
            <div class="mb-8">
                <div
                    class="relative w-48 h-56 md:w-56 md:h-72 bg-white dark:bg-neutral-800 p-3 shadow-xl ring-1 ring-neutral-900/5 dark:ring-white/5"
                >
                    <div
                        class="w-full h-full overflow-hidden bg-neutral-200 dark:bg-neutral-700 relative"
                    >
                        <Image
                            src={bioEntry.data.image}
                            alt="Portrait of the artist"
                            width={400}
                            height={500}
                            class="w-full h-full object-cover"
                        />
                        <div
                            class="absolute inset-0 shadow-[inset_0_0_20px_rgba(0,0,0,0.1)] pointer-events-none"
                        >
                        </div>
                    </div>
                </div>
            </div>

            <h1
                class="font-serif text-5xl md:text-6xl text-neutral-900 dark:text-neutral-50 mb-4"
            >
                {bioEntry.data.title}
            </h1>

            <p
                class="text-sm font-sans uppercase tracking-widest text-neutral-500 dark:text-neutral-400"
            >
                1927 &mdash; 2010
            </p>
        </header>

        <hr
            class="w-12 border-neutral-300 dark:border-neutral-700 mx-auto mb-16"
        />

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
            <aside class="lg:col-span-4">
                <blockquote
                    class="font-serif text-2xl italic text-neutral-800 dark:text-neutral-200 leading-relaxed border-l-2 border-neutral-900 dark:border-neutral-100 pl-6 sticky top-24"
                >
                    "{
                        bioEntry.data.pull_quote ||
                            "Art is the elimination of the unnecessary."
                    }"
                </blockquote>
            </aside>

            <div class="lg:col-span-8">
                <article
                    class="prose prose-neutral dark:prose-invert prose-lg prose-p:font-light prose-p:leading-8 prose-headings:font-serif prose-headings:font-normal"
                >
                    <Content />
                </article>

                <div class="mt-16 text-center">
                    <a
                        href="/"
                        class="inline-block px-8 py-3 border border-neutral-900 dark:border-neutral-100 text-neutral-900 dark:text-neutral-100 text-sm font-medium uppercase tracking-widest hover:bg-neutral-900 dark:hover:bg-neutral-100 hover:text-white dark:hover:text-neutral-900 transition-colors duration-300"
                    >
                        View Gallery
                    </a>
                </div>
            </div>
        </div>
    </main>

    <footer
        class="text-center py-12 border-t border-neutral-200 dark:border-neutral-800 mt-12"
    >
        <p class="text-neutral-400 text-sm font-serif italic">
            Curated by the artist's family.
        </p>
    </footer>
</Layout>

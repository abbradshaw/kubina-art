---
import Layout from "../../layouts/Layout.astro";
import { marked } from "marked";
import { sanityClient, artworkSrc } from "../../lib/sanity";
import { getAllWorks, getCategoryOrder } from "../../lib/works";

export async function getStaticPaths() {
    const works = await getAllWorks();
    const categoryOrder = await getCategoryOrder();
    const sorted = works.sort((a, b) => {
        const catA = categoryOrder.indexOf(a.category);
        const catB = categoryOrder.indexOf(b.category);
        if (catA !== catB) return catA - catB;
        return parseInt(b.year) - parseInt(a.year);
    });
    return sorted.map((work) => ({
        params: { slug: work.slug },
    }));
}

const { slug } = Astro.params;

const [entry, allWorks] = await Promise.all([
    sanityClient.fetch(`*[_type == "work" && slug.current == $slug][0]`, { slug }),
    sanityClient.fetch(`*[_type == "work"]{title, "slug": slug.current, category}`),
]);

if (!entry) return Astro.redirect("/404");

const categoryOrder = await getCategoryOrder();
const ordered = allWorks.sort((a, b) => {
    const catA = categoryOrder.indexOf(a.category);
    const catB = categoryOrder.indexOf(b.category);
    if (catA !== catB) return catA - catB;
    return (a.title ?? '').localeCompare(b.title ?? '');
});
const index = ordered.findIndex((w) => w.slug === slug);
const prevEntry = index === 0 ? ordered[ordered.length - 1] : ordered[index - 1];
const nextEntry = index === ordered.length - 1 ? ordered[0] : ordered[index + 1];
---

<Layout title={`${entry.title} | Peter Kubina Archive`}>
    <nav
        class="fixed top-0 left-0 w-full z-50 bg-white/90 backdrop-blur-sm border-b border-neutral-100 text-neutral-900 dark:bg-[#171717]/90 dark:border-neutral-800 dark:text-gray-100 transition-all duration-300"
    >
        <div class="px-6 py-4 flex justify-between items-center relative">
            <a
                href="/"
                class="text-base font-medium tracking-widest uppercase hover:underline underline-offset-4 decoration-1"
            >
                ← Back to Collection
            </a>

            <div class="flex gap-8">
                <a
                    href={`/work/${prevEntry.slug}`}
                    class="group flex items-center gap-2 text-sm uppercase tracking-widest text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-gray-100 transition-colors"
                >
                    <span class="w-8 h-8 rounded-full border border-neutral-300 group-hover:border-neutral-900 dark:border-neutral-700 dark:group-hover:border-gray-100 flex items-center justify-center transition-colors">←</span>
                    <span class="hidden md:inline">Prev</span>
                </a>
                <a
                    href={`/work/${nextEntry.slug}`}
                    class="group flex items-center gap-2 text-sm uppercase tracking-widest text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-gray-100 transition-colors"
                >
                    <span class="hidden md:inline">Next</span>
                    <span class="w-8 h-8 rounded-full border border-neutral-300 group-hover:border-neutral-900 dark:border-neutral-700 dark:group-hover:border-gray-100 flex items-center justify-center transition-colors">→</span>
                </a>
            </div>
        </div>
    </nav>

    <main class="pt-24 pb-24 px-6 max-w-7xl mx-auto">
        <article class="max-w-5xl mx-auto">
            <header class="mb-16 text-center">
                <h1 class="font-serif text-4xl md:text-6xl text-neutral-900 dark:text-gray-100 tracking-tight mb-4">
                    {entry.title}
                </h1>
                <p class="text-base text-neutral-500 uppercase tracking-wide">
                    {entry.medium}
                    {entry.dimensions && ` — ${entry.dimensions}`}
                </p>
            </header>

            <figure class="mb-16 artwork-figure relative">
                <img
                    src={artworkSrc(entry.image, 1400)}
                    alt={entry.title}
                    class="w-full h-auto"
                    loading="eager"
                    draggable="false"
                />
                <div class="absolute inset-0 pointer-events-none"></div>
            </figure>

            <div class="grid md:grid-cols-[2fr_1fr] gap-16">
                <div class="prose prose-lg prose-neutral dark:prose-invert max-w-none">
                    {entry.description && (
                        <Fragment set:html={marked.parse(entry.description)} />
                    )}
                </div>

                <aside class="space-y-8 text-sm">
                    <div>
                        <dt class="uppercase tracking-widest text-xs text-neutral-500 mb-1">Year</dt>
                        <dd class="text-neutral-900 dark:text-gray-100 font-medium text-lg">{entry.year}</dd>
                    </div>
                    <div>
                        <dt class="uppercase tracking-widest text-xs text-neutral-500 mb-1">Category</dt>
                        <dd class="text-neutral-900 dark:text-gray-100 font-medium text-lg">{entry.category}</dd>
                    </div>
                    <div>
                        <dt class="uppercase tracking-widest text-xs text-neutral-500 mb-1">Status</dt>
                        <dd class="text-neutral-900 dark:text-gray-100 font-medium text-lg">{entry.status || "Available"}</dd>
                    </div>
                    {entry.medium && (
                        <div>
                            <dt class="uppercase tracking-widest text-xs text-neutral-500 mb-1">Medium</dt>
                            <dd class="text-neutral-900 dark:text-gray-100 font-medium text-lg">{entry.medium}</dd>
                        </div>
                    )}
                </aside>
            </div>

            <div class="mt-24 flex justify-between items-center">
                <a
                    href={`/work/${prevEntry.slug}`}
                    class="group flex items-center gap-4 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-gray-100 transition-colors"
                >
                    <span class="w-12 h-12 rounded-full border border-neutral-300 group-hover:border-neutral-900 dark:border-neutral-700 dark:group-hover:border-gray-100 flex items-center justify-center text-xl transition-colors">←</span>
                    <div class="text-left">
                        <span class="block text-xs uppercase tracking-widest">Previous</span>
                        <span class="font-serif text-lg">{prevEntry.title}</span>
                    </div>
                </a>

                <a
                    href={`/work/${nextEntry.slug}`}
                    class="group flex items-center gap-4 text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-gray-100 transition-colors"
                >
                    <div class="text-right">
                        <span class="block text-xs uppercase tracking-widest">Next</span>
                        <span class="font-serif text-lg">{nextEntry.title}</span>
                    </div>
                    <span class="w-12 h-12 rounded-full border border-neutral-300 group-hover:border-neutral-900 dark:border-neutral-700 dark:group-hover:border-gray-100 flex items-center justify-center text-xl transition-colors">→</span>
                </a>
            </div>
        </article>
    </main>
</Layout>

<style>
    .artwork-figure img {
        -webkit-user-drag: none;
        user-select: none;
        -webkit-user-select: none;
    }
</style>

<script>
    document.querySelectorAll(".artwork-figure img").forEach((img) => {
        img.addEventListener("contextmenu", (e) => e.preventDefault());
    });
</script>

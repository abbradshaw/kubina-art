---
import Layout from "../../layouts/Layout.astro";
import { artworkSrc } from "../../lib/sanity";
import { getAllWorks, getWorkBySlug } from "../../lib/works";
import { marked } from "marked";

export async function getStaticPaths() {
  const works = await getAllWorks();
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { slug } = Astro.params;
const work = await getWorkBySlug(slug as string);
if (!work) return Astro.redirect("/404");
---

<Layout title={work.title} description={`${work.title} — ${work.category}`}>
	<article class="max-w-5xl mx-auto px-6 py-12">
		<header class="mb-12">
			<nav class="mb-8">
				<a href="/" class="text-sm tracking-widest uppercase text-neutral-500 hover:text-black transition-colors">← Back to Collection</a>
			</nav>
			<h1 class="font-serif text-3xl md:text-5xl text-neutral-900 mb-4">{work.title}</h1>
			<p class="text-base text-neutral-500 uppercase tracking-wide">{work.medium} {work.dimensions && `— ${work.dimensions}`}</p>
		</header>

		<figure class="mb-12">
			<img src={artworkSrc(work.image, 1200)} alt={work.title} class="w-full h-auto" loading="eager" />
		</figure>

		<div class="grid md:grid-cols-[2fr_1fr] gap-12">
			<div class="prose prose-lg prose-neutral dark:prose-invert">
				{work.description && <Fragment set:html={marked.parse(work.description)} />}
			</div>
			<aside class="space-y-6 text-sm text-neutral-500">
				<div>
					<dt class="uppercase tracking-wider text-xs mb-1">Year</dt>
					<dd class="text-neutral-900 font-medium">{work.year}</dd>
				</div>
				<div>
					<dt class="uppercase tracking-wider text-xs mb-1">Category</dt>
					<dd class="text-neutral-900 font-medium">{work.category}</dd>
				</div>
				<div>
					<dt class="uppercase tracking-wider text-xs mb-1">Status</dt>
					<dd class="text-neutral-900 font-medium">{work.status || "Available"}</dd>
				</div>
			</aside>
		</div>
	</article>
</Layout>
